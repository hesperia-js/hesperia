{
  "name": "@hesperia/tooling",
  "version": "1.0.0-alpha.1",
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/hesperia-js/hesperia.git",
    "directory": "packages/tooling"
  },
  "bin": {
    "hesperia": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/project-service.js",
