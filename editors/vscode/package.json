{
  "name": "hesperia-vscode",
  "displayName": "Hesperia",
  "version": "0.0.0",
  "private": true,
  "description": "Authored TSX diagnostics and navigation for Hesperia projects.",
  "categories": [
    "Programming Languages"
  ],
  "license": "MPL-2.0",
  "publisher": "hesperia",
  "main": "./dist/extension.cjs",
  "scripts": {
    "build": "bun build src/extension.ts --target=node --format=cjs --external=vscode --outfile=dist/extension.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:test": "bun build tests/host.ts --target=node --format=cjs --external=vscode --outfile=dist/test-host.cjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.1"
  },
  "devDependencies": {
    "@types/vscode": "1.137.0",
    "typescript": "7.0.2"
  },
  "contributes": {
    "languages": [
      {
        "id": "hesperia-tsx",
        "aliases": [
          "Hesperia TSX"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "hesperia-tsx",
        "scopeName": "source.hesperia.tsx",
        "path": "./syntaxes/hesperia.tmLanguage.json"
      }
    ]
  },
  "activationEvents": [
    "onLanguage:hesperia-tsx",
    "workspaceContains:package.json"
  ],
  "engines": {
    "vscode": "^1.137.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  }
}
