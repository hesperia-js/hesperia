{
  "compilerOptions": {
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "packages/**/*.ts",
    "tests/**/*.ts",
    "scripts/**/*.ts",
    "golden/**/*.ts",
    "editors/vscode/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "**/dist",
    "build",
    "golden/fixtures",
    "packages/create-hesperia/templates",
    "tests/package/fixtures/installed-app",
    "tests/package/fixtures/applications",
    "tests/tooling/fixtures/applications",
    "tests/compiler/fixtures/applications",
    "tests/editor/fixtures/applications"
  ]
}
